{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./electron",
    "rootDir": "./electron"
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules"]
}
